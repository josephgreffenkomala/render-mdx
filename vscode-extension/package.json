{
  "name": "render-mdx-vscode",
  "displayName": "render-mdx Preview",
  "description": "Preview MDX with render-mdx styling and source-backed revision notes.",
  "version": "0.1.2",
  "publisher": "render-mdx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/josephgreffenkomala/render-mdx.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "MDX expressions are compiled for the preview, so render-mdx Preview requires a trusted workspace."
    }
  },
  "files": ["dist/**", "media/**", "README.md"],
  "categories": ["Other"],
  "keywords": ["mdx", "markdown", "preview", "notes"],
  "main": "./dist/extension.js",
  "activationEvents": ["onCommand:renderMdx.openPreview"],
  "contributes": {
    "commands": [
      {
        "command": "renderMdx.openPreview",
        "title": "Open render-mdx Preview",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "renderMdx.openPreview",
          "when": "resourceExtname == .mdx",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "test": "vitest run",
    "check": "tsc --noEmit && npm test && npm run build",
    "package": "npm run check && vsce package --no-dependencies"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.0",
    "mermaid": "^11.12.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
