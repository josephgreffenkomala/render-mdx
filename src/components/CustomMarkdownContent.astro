---
import '@astrojs/starlight/style/markdown.css';

const apiUrl = import.meta.env.RENDER_MDX_API_URL || 'http://127.0.0.1:8765';
---

<div class="sl-markdown-content"><slot /></div>

<dialog class="rmx-note-dialog" data-note-dialog>
  <form method="dialog" data-note-form>
    <div class="rmx-note-dialog__header">
      <div>
        <span class="rmx-note-dialog__eyebrow">Revision note</span>
        <strong>Add feedback to this MDX file</strong>
      </div>
      <button type="button" class="rmx-note-dialog__close" data-note-cancel aria-label="Close">×</button>
    </div>
    <p class="rmx-note-dialog__context" data-note-context></p>
    <textarea data-note-input rows="5" maxlength="10000" required placeholder="What should the agent revise, clarify, remove, or add?"></textarea>
    <p class="rmx-note-dialog__status" data-note-status aria-live="polite"></p>
    <div class="rmx-note-dialog__actions">
      <button type="button" data-note-cancel>Cancel</button>
      <button type="submit" class="rmx-note-dialog__save">Save to MDX</button>
    </div>
  </form>
</dialog>

<script type="module">
  import mermaid from 'mermaid';

  const darkThemeVariables = {
    primaryColor: '#111827',
    primaryTextColor: '#e5e7eb',
    primaryBorderColor: '#6366f1',
    lineColor: '#818cf8',
    secondaryColor: '#0f172a',
    tertiaryColor: '#020617',
    background: '#09090b',
    mainBkg: '#111827',
    secondBkg: '#0f172a',
    tertiaryBkg: '#020617',
    clusterBkg: '#111827',
    clusterBorder: '#4f46e5',
    edgeLabelBackground: '#18181b',
    actorBkg: '#111827',
    actorBorder: '#6366f1',
    actorTextColor: '#e5e7eb',
    noteBkgColor: '#312e81',
    noteTextColor: '#e0e7ff',
    noteBorderColor: '#818cf8',
    labelBoxBkgColor: '#18181b',
    labelTextColor: '#e5e7eb',
  };

  const lightThemeVariables = {
    primaryColor: '#ffffff',
    primaryTextColor: '#0f172a',
    primaryBorderColor: '#6366f1',
    lineColor: '#4f46e5',
    secondaryColor: '#eef2ff',
    tertiaryColor: '#f8fafc',
    background: '#ffffff',
    mainBkg: '#ffffff',
    secondBkg: '#eef2ff',
    tertiaryBkg: '#f8fafc',
    clusterBkg: '#f8fafc',
    clusterBorder: '#6366f1',
    edgeLabelBackground: '#ffffff',
    actorBkg: '#ffffff',
    actorBorder: '#6366f1',
    actorTextColor: '#0f172a',
    noteBkgColor: '#eef2ff',
    noteTextColor: '#312e81',
    noteBorderColor: '#818cf8',
    labelBoxBkgColor: '#ffffff',
    labelTextColor: '#0f172a',
  };

  function isLightTheme() {
    return document.documentElement.dataset.theme === 'light';
  }

  function mermaidConfig() {
    return {
      startOnLoad: false,
      securityLevel: 'loose',
      theme: 'base',
      themeVariables: isLightTheme() ? lightThemeVariables : darkThemeVariables,
      fontFamily: 'Inter, ui-sans-serif, system-ui, sans-serif',
      flowchart: {
        useMaxWidth: true,
        htmlLabels: true,
        curve: 'basis',
      },
      sequence: {
        useMaxWidth: true,
        wrap: true,
      },
      gantt: {
        useMaxWidth: true,
      },
      er: {
        useMaxWidth: true,
      },
    };
  }

  class MermaidDiagram extends HTMLElement {
    source = '';
    scale = 1;
    minScale = 0.25;
    maxScale = 4;
    translateX = 0;
    translateY = 0;
    dragStartX = 0;
    dragStartY = 0;
    startTranslateX = 0;
    startTranslateY = 0;
    isDragging = false;
    resizeObserver = null;
    naturalWidth = 1;
    naturalHeight = 1;

    connectedCallback() {
      this.source = decodeURIComponent(this.dataset.source || '').trim();
      if (!this.source) {
        this.innerHTML = '<div class="mermaid-error">Empty Mermaid source.</div>';
        return;
      }
      this.renderDiagram();
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
      document.removeEventListener('fullscreenchange', this.onFullscreenChange);
    }

    async renderDiagram() {
      const sourceEscaped = this.escapeHtml(this.source);
      this.innerHTML = `
        <div class="mermaid-shell">
          <div class="mermaid-toolbar">
            <div class="mermaid-toolbar-left">
              <span class="mermaid-badge">Mermaid</span>
              <span class="mermaid-hint">Drag to pan • wheel to zoom</span>
            </div>
            <div class="mermaid-controls" aria-label="Diagram controls">
              <button type="button" class="mermaid-control" data-action="zoom-out" title="Zoom out">-</button>
              <button type="button" class="mermaid-control" data-action="zoom-in" title="Zoom in">+</button>
              <button type="button" class="mermaid-control" data-action="fit" title="Fit diagram">Fit</button>
              <button type="button" class="mermaid-control" data-action="reset" title="Reset zoom">100%</button>
              <button type="button" class="mermaid-control" data-action="fullscreen" title="Open fullscreen">Full</button>
            </div>
          </div>
          <div class="mermaid-stage">
            <div class="mermaid-loading">Rendering diagram...</div>
          </div>
          <details class="mermaid-source-panel">
            <summary>Show source</summary>
            <pre><code class="language-mermaid">${sourceEscaped}</code></pre>
          </details>
        </div>
      `;

      const stage = this.querySelector('.mermaid-stage');
      if (!stage) return;

      try {
        mermaid.initialize(mermaidConfig());
        const id = `mermaid-${Math.random().toString(36).slice(2)}`;
        const { svg, bindFunctions } = await mermaid.render(id, this.source);
        stage.innerHTML = `
          <div class="mermaid-viewport">
            <div class="mermaid-canvas">
              <div class="mermaid-svg">${svg}</div>
            </div>
          </div>
        `;
        bindFunctions?.(stage);
        this.setupPanZoom();
      } catch (error) {
        const message = error instanceof Error ? error.message : String(error);
        stage.innerHTML = `
          <div class="mermaid-error">
            <strong>Mermaid render failed</strong>
            <div>${this.escapeHtml(message)}</div>
          </div>
        `;
      }
    }

    escapeHtml(value) {
      return value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    onFullscreenChange = () => {
      const button = this.querySelector('[data-action="fullscreen"]');
      const active = document.fullscreenElement === this.querySelector('.mermaid-shell');
      if (button) {
        button.textContent = active ? 'Exit' : 'Full';
        button.setAttribute('title', active ? 'Exit fullscreen' : 'Open fullscreen');
      }
      setTimeout(() => this.fitToViewport(), 30);
    };

    safeBBox(svg) {
      try {
        return svg.getBBox();
      } catch {
        return { width: 0, height: 0 };
      }
    }

    measureDiagram(svg, canvas) {
      const viewBox = svg.viewBox?.baseVal;
      const bbox = this.safeBBox(svg);
      const attrWidth = Number.parseFloat(svg.getAttribute('width') || '0');
      const attrHeight = Number.parseFloat(svg.getAttribute('height') || '0');

      this.naturalWidth = viewBox?.width || bbox.width || attrWidth || 1200;
      this.naturalHeight = viewBox?.height || bbox.height || attrHeight || 800;

      svg.setAttribute('width', String(this.naturalWidth));
      svg.setAttribute('height', String(this.naturalHeight));
      svg.style.width = `${this.naturalWidth}px`;
      svg.style.height = `${this.naturalHeight}px`;
      canvas.style.width = `${this.naturalWidth}px`;
      canvas.style.height = `${this.naturalHeight}px`;
    }

    setupPanZoom() {
      const viewport = this.querySelector('.mermaid-viewport');
      const canvas = this.querySelector('.mermaid-canvas');
      const svg = this.querySelector('.mermaid-svg svg');
      if (!viewport || !canvas || !svg) return;

      this.measureDiagram(svg, canvas);

      this.querySelectorAll('.mermaid-control').forEach((button) => {
        button.addEventListener('click', () => {
          const action = button.getAttribute('data-action');
          if (action === 'zoom-in') this.zoomBy(1.2);
          if (action === 'zoom-out') this.zoomBy(1 / 1.2);
          if (action === 'fit') this.fitToViewport();
          if (action === 'reset') this.resetZoom();
          if (action === 'fullscreen') this.toggleFullscreen();
        });
      });

      viewport.addEventListener('wheel', (event) => {
        event.preventDefault();
        const delta = event.deltaY < 0 ? 1.1 : 1 / 1.1;
        this.zoomAtPoint(delta, event.clientX, event.clientY, viewport);
      }, { passive: false });

      viewport.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        this.isDragging = true;
        this.dragStartX = event.clientX;
        this.dragStartY = event.clientY;
        this.startTranslateX = this.translateX;
        this.startTranslateY = this.translateY;
        viewport.classList.add('is-dragging');
        viewport.setPointerCapture(event.pointerId);
      });

      viewport.addEventListener('pointermove', (event) => {
        if (!this.isDragging) return;
        this.translateX = this.startTranslateX + (event.clientX - this.dragStartX);
        this.translateY = this.startTranslateY + (event.clientY - this.dragStartY);
        this.applyTransform();
      });

      const stopDrag = (event) => {
        if (!this.isDragging) return;
        this.isDragging = false;
        viewport.classList.remove('is-dragging');
        if (event?.pointerId != null && viewport.hasPointerCapture(event.pointerId)) {
          viewport.releasePointerCapture(event.pointerId);
        }
      };

      viewport.addEventListener('pointerup', stopDrag);
      viewport.addEventListener('pointercancel', stopDrag);
      viewport.addEventListener('pointerleave', stopDrag);

      this.resizeObserver?.disconnect();
      this.resizeObserver = new ResizeObserver(() => this.fitToViewport({ preserveZoomIfLarger: true }));
      this.resizeObserver.observe(viewport);
      document.removeEventListener('fullscreenchange', this.onFullscreenChange);
      document.addEventListener('fullscreenchange', this.onFullscreenChange);

      this.fitToViewport();
    }

    applyTransform() {
      const canvas = this.querySelector('.mermaid-canvas');
      const zoomLabel = this.querySelector('[data-action="reset"]');
      if (!canvas) return;
      canvas.style.transform = `translate(${this.translateX}px, ${this.translateY}px) scale(${this.scale})`;
      if (zoomLabel) zoomLabel.textContent = `${Math.round(this.scale * 100)}%`;
    }

    zoomBy(factor) {
      const viewport = this.querySelector('.mermaid-viewport');
      if (!viewport) return;
      const rect = viewport.getBoundingClientRect();
      this.zoomAtPoint(factor, rect.left + rect.width / 2, rect.top + rect.height / 2, viewport);
    }

    zoomAtPoint(factor, clientX, clientY, viewport) {
      const nextScale = Math.min(this.maxScale, Math.max(this.minScale, this.scale * factor));
      if (nextScale === this.scale) return;
      const rect = viewport.getBoundingClientRect();
      const pointX = clientX - rect.left;
      const pointY = clientY - rect.top;
      const scaleRatio = nextScale / this.scale;

      this.translateX = pointX - (pointX - this.translateX) * scaleRatio;
      this.translateY = pointY - (pointY - this.translateY) * scaleRatio;
      this.scale = nextScale;
      this.applyTransform();
    }

    resetZoom() {
      this.scale = 1;
      this.translateX = 0;
      this.translateY = 0;
      this.applyTransform();
      this.centerIfSmaller();
    }

    fitToViewport(options = {}) {
      const viewport = this.querySelector('.mermaid-viewport');
      if (!viewport) return;

      const naturalWidth = this.naturalWidth || 1;
      const naturalHeight = this.naturalHeight || 1;
      const availableWidth = Math.max(viewport.clientWidth - 24, 1);
      const availableHeight = Math.max(viewport.clientHeight - 24, 1);
      const fitScale = Math.min(1.5, Math.max(this.minScale, Math.min(availableWidth / naturalWidth, availableHeight / naturalHeight)));

      if (options.preserveZoomIfLarger && this.scale > fitScale) {
        this.centerIfSmaller();
        return;
      }

      this.scale = fitScale;
      const scaledWidth = naturalWidth * this.scale;
      const scaledHeight = naturalHeight * this.scale;
      this.translateX = Math.max((viewport.clientWidth - scaledWidth) / 2, 0);
      this.translateY = Math.max((viewport.clientHeight - scaledHeight) / 2, 0);
      this.applyTransform();
    }

    centerIfSmaller() {
      const viewport = this.querySelector('.mermaid-viewport');
      if (!viewport) return;
      const naturalWidth = this.naturalWidth || 1;
      const naturalHeight = this.naturalHeight || 1;
      const scaledWidth = naturalWidth * this.scale;
      const scaledHeight = naturalHeight * this.scale;
      if (scaledWidth <= viewport.clientWidth) {
        this.translateX = (viewport.clientWidth - scaledWidth) / 2;
      }
      if (scaledHeight <= viewport.clientHeight) {
        this.translateY = (viewport.clientHeight - scaledHeight) / 2;
      }
      this.applyTransform();
    }

    async toggleFullscreen() {
      const shell = this.querySelector('.mermaid-shell');
      if (!shell) return;
      if (document.fullscreenElement === shell) {
        await document.exitFullscreen();
        return;
      }
      await shell.requestFullscreen();
    }
  }

  if (!customElements.get('mermaid-diagram')) {
    customElements.define('mermaid-diagram', MermaidDiagram);
  }

  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
        document.querySelectorAll('mermaid-diagram').forEach((element) => {
          element.renderDiagram?.();
        });
      }
    }
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>

<script define:vars={{ apiUrl }}>
  const content = document.querySelector('.sl-markdown-content');
  const dialog = document.querySelector('[data-note-dialog]');
  const noteForm = dialog?.querySelector('[data-note-form]');
  const noteInput = dialog?.querySelector('[data-note-input]');
  const noteContext = dialog?.querySelector('[data-note-context]');
  const noteStatus = dialog?.querySelector('[data-note-status]');
  const saveButton = dialog?.querySelector('.rmx-note-dialog__save');
  let currentDocument = null;
  let activeTarget = null;
  let activeContext = '';

  function normalizedPath(value) {
    const path = new URL(value, window.location.origin).pathname;
    return path.endsWith('/') ? path : `${path}/`;
  }

  async function apiRequest(path, options = {}) {
    const response = await fetch(`${apiUrl}${path}`, {
      headers: { 'Content-Type': 'application/json' },
      ...options,
    });
    const payload = await response.json();
    if (!response.ok) throw new Error(payload.error || 'Request failed');
    return payload;
  }

  function normalizedText(value) {
    return String(value || '').replace(/\s+/g, ' ').trim();
  }

  function targetKind(target) {
    if (/^H[1-6]$/.test(target.tagName)) return 'heading';
    if (target.matches('p')) return 'paragraph';
    if (target.matches('ul, ol')) return 'list';
    if (target.matches('pre')) return 'code block';
    if (target.matches('table')) return 'table';
    if (target.matches('blockquote')) return 'quote';
    if (target.matches('details')) return 'details';
    if (target.matches('mermaid-diagram')) return 'diagram';
    if (target.matches('.card, .sl-link-card')) return 'card';
    if (target.matches('.starlight-aside')) return 'aside';
    if (target.matches('starlight-file-tree')) return 'file tree';
    if (target.matches('starlight-tabs')) return 'tabs';
    return 'content block';
  }

  function headingPath(target, headings) {
    const stack = [];
    for (const heading of headings) {
      if (heading !== target && !(heading.compareDocumentPosition(target) & Node.DOCUMENT_POSITION_FOLLOWING)) {
        continue;
      }
      const level = Number(heading.tagName.slice(1));
      while (stack.length && stack.at(-1).level >= level) stack.pop();
      stack.push({ level, text: normalizedText(heading.textContent) });
      if (heading === target) break;
    }
    const path = stack.filter((item) => item.level > 1).map((item) => item.text);
    return path.join(' › ') || stack.at(-1)?.text || 'Document';
  }

  function describeTargets(targets) {
    const headings = [...content.querySelectorAll('h1, h2, h3, h4, h5, h6')];
    const counts = new Map();
    for (const target of targets) {
      const section = headingPath(target, headings);
      const kind = targetKind(target);
      const countKey = `${section}\u0000${kind}`;
      const position = (counts.get(countKey) || 0) + 1;
      counts.set(countKey, position);
      const excerpt = normalizedText(target.innerText || target.textContent).slice(0, 140);
      const label = `${section} › ${kind} ${position}${excerpt ? ` — “${excerpt}”` : ''}`;
      target.dataset.rmxNoteTarget = label;
    }
  }

  function noteTargets() {
    if (!content) return [];
    const revisionHeading = [...content.querySelectorAll('h2')].find(
      (heading) => heading.textContent.trim().toLowerCase() === 'revision notes'
    );
    const candidates = [
      ...content.querySelectorAll(
        ':scope > :is(h1, h2, h3, h4, h5, h6, p, ul, ol, pre, table, blockquote, details, mermaid-diagram), :scope > * :is(.card, .sl-link-card, .starlight-aside, starlight-file-tree, starlight-tabs)'
      ),
    ];
    return candidates.filter((target) => !revisionHeading || target.compareDocumentPosition(revisionHeading) & Node.DOCUMENT_POSITION_FOLLOWING);
  }

  function revisionNoteContext(blockquote) {
    const targetLabel = [...blockquote.querySelectorAll('strong')].find(
      (strong) => normalizedText(strong.textContent).toLowerCase() === 'target:'
    );
    if (!targetLabel?.parentElement) return '';
    return normalizedText(targetLabel.parentElement.textContent.replace(targetLabel.textContent, ''));
  }

  function revisionNoteId(blockquote) {
    return blockquote.querySelector('[data-rmx-note-id]')?.dataset.rmxNoteId || '';
  }

  function compactRevisionNote(blockquote, context) {
    const noteId = revisionNoteId(blockquote);
    const details = window.document.createElement('details');
    details.className = 'rmx-inline-revision-note';
    const summary = window.document.createElement('summary');
    const title = window.document.createElement('span');
    title.className = 'rmx-inline-revision-note__title';
    title.textContent = 'Note';
    const target = window.document.createElement('span');
    target.className = 'rmx-inline-revision-note__target';
    target.textContent = context.split(' — ', 1)[0];
    target.title = context;
    summary.append(title, target);

    const revisionLabel = [...blockquote.querySelectorAll('strong')].find(
      (strong) => normalizedText(strong.textContent).toLowerCase() === 'revision note'
    );
    const targetLabel = [...blockquote.querySelectorAll('strong')].find(
      (strong) => normalizedText(strong.textContent).toLowerCase() === 'target:'
    );
    revisionLabel?.parentElement?.remove();
    targetLabel?.parentElement?.remove();
    blockquote.querySelector('[data-rmx-note-id]')?.remove();
    blockquote.classList.add('rmx-inline-revision-note__content');

    const actions = window.document.createElement('div');
    actions.className = 'rmx-inline-revision-note__actions';
    const deleteButton = window.document.createElement('button');
    deleteButton.type = 'button';
    deleteButton.className = 'rmx-inline-revision-note__delete';
    deleteButton.textContent = 'Delete note';
    if (!noteId) {
      deleteButton.disabled = true;
      deleteButton.title = 'This older note has no deletion ID.';
    } else {
      deleteButton.addEventListener('click', async () => {
        if (!window.confirm('Delete this revision note from the source MDX?')) return;
        deleteButton.disabled = true;
        deleteButton.textContent = 'Deleting…';
        try {
          await apiRequest('/api/notes/delete', {
            method: 'POST',
            body: JSON.stringify({ path: currentDocument.path, noteId }),
          });
          details.remove();
        } catch (error) {
          deleteButton.disabled = false;
          deleteButton.textContent = 'Delete note';
          deleteButton.title = error.message || 'Could not delete note.';
        }
      });
    }
    actions.append(deleteButton);
    details.append(summary, blockquote, actions);
    return details;
  }

  function findNoteTarget(context, targets) {
    const exact = targets.find((target) => target.dataset.rmxNoteTarget === context);
    if (exact) return exact;

    const [legacySection, legacyExcerpt = ''] = context.split(' — ', 2);
    const cleanExcerpt = normalizedText(legacyExcerpt).replace(/^[“"]|[”"]$/g, '');
    return targets.find((target) => {
      const label = target.dataset.rmxNoteTarget || '';
      const targetText = normalizedText(target.innerText || target.textContent);
      return label.includes(legacySection) && (!cleanExcerpt || targetText.includes(cleanExcerpt));
    }) || null;
  }

  function placeRevisionNotes(targets) {
    const revisionHeading = [...content.querySelectorAll('h2')].find(
      (heading) => normalizedText(heading.textContent).toLowerCase() === 'revision notes'
    );
    if (!revisionHeading) return;
    const notes = [...content.querySelectorAll('blockquote')].filter(
      (blockquote) => revisionHeading.compareDocumentPosition(blockquote) & Node.DOCUMENT_POSITION_FOLLOWING
    );
    const lastNoteByTarget = new Map();
    let placed = 0;
    for (const note of notes) {
      const context = revisionNoteContext(note);
      const target = findNoteTarget(context, targets);
      if (!target) continue;
      const compactNote = compactRevisionNote(note, context);
      const previousNote = lastNoteByTarget.get(target);
      if (previousNote) {
        previousNote.after(compactNote);
      } else if (target.matches('.card, .sl-link-card')) {
        compactNote.classList.add('rmx-inline-revision-note--embedded');
        target.append(compactNote);
      } else {
        target.after(compactNote);
      }
      lastNoteByTarget.set(target, compactNote);
      placed += 1;
    }
    if (placed === notes.length) revisionHeading.remove();
  }

  function positionNoteButton(button, target) {
    const contentRect = content.getBoundingClientRect();
    const targetRect = target.getBoundingClientRect();
    const targetTop = targetRect.top - contentRect.top + content.scrollTop;
    button.style.top = `${Math.max(0, targetTop - button.offsetHeight - 4)}px`;
    button.hidden = false;
  }

  function installNoteButton(targets) {
    if (!content) return;
    if (!targets.length) return;
    const button = window.document.createElement('button');
    button.type = 'button';
    button.className = 'rmx-add-note print:hidden';
    button.textContent = '+ Note';
    button.hidden = true;
    button.title = 'Add a revision note to the source MDX';
    content.append(button);
    for (const target of targets) {
      target.addEventListener('pointerenter', () => {
        activeTarget = target;
        activeContext = target.dataset.rmxNoteTarget;
        positionNoteButton(button, target);
      });
    }
    button.addEventListener('click', () => {
      if (!currentDocument || !activeTarget || !dialog) {
        return;
      }
      noteContext.textContent = activeContext;
      noteStatus.textContent = '';
      noteInput.value = '';
      dialog.showModal();
      noteInput.focus();
    });
    activeTarget = targets[0];
    activeContext = activeTarget.dataset.rmxNoteTarget;
    positionNoteButton(button, activeTarget);
  }

  async function loadCurrentDocument() {
    try {
      const state = await apiRequest('/api/state');
      const currentPath = normalizedPath(window.location.pathname);
      currentDocument = (state.documents || []).find(
        (document) => normalizedPath(document.url) === currentPath
      ) || null;
      if (!currentDocument) return;
      const targets = noteTargets();
      describeTargets(targets);
      placeRevisionNotes(targets);
      installNoteButton(targets);
    } catch (error) {
      console.warn('render-mdx note controls unavailable:', error);
    }
  }

  dialog?.querySelectorAll('[data-note-cancel]').forEach((button) => {
    button.addEventListener('click', () => dialog.close());
  });

  noteForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!currentDocument || !noteInput?.value.trim()) return;
    saveButton.disabled = true;
    noteStatus.textContent = 'Saving…';
    noteStatus.dataset.error = 'false';
    try {
      await apiRequest('/api/notes', {
        method: 'POST',
        body: JSON.stringify({
          path: currentDocument.path,
          context: activeContext,
          note: noteInput.value,
        }),
      });
      noteStatus.textContent = 'Saved to the source MDX. Reloading…';
      window.setTimeout(() => window.location.reload(), 450);
    } catch (error) {
